{
  "name": "novella-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check:boundaries && npm run typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "dev:mobile": "npm run dev --workspace @novella/mobile",
    "dev:site": "npm run dev --workspace @novella/site",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
